# PostgreSQL
# Docker Compose: localhost:5432
# Embedded dev DB (npm run db:dev): localhost:55432
DATABASE_URL=postgres://chiron:chiron@localhost:5432/chiron

# Auth
AUTH_SECRET=dev-secret-change-me-32-characters
# 1 enables the dev login button and magic-link echo. Ignored in production.
AUTH_DEV_MODE=1
APP_URL=http://localhost:3000
# Extra allowed origins for CSRF checks, comma-separated.
ALLOWED_ORIGINS=
# Alpha signup allowlist. Exact emails or *@domain entries, comma-separated.
# Empty blocks new email signups in production; existing users can still log in.
ALPHA_EMAIL_ALLOWLIST=

# Telegram Mini App / Login Widget
TELEGRAM_BOT_TOKEN=
# Bot username for the Login Widget, without @.
TELEGRAM_BOT_USERNAME=
# Comma-separated usernames (without @) and/or numeric Telegram ids.
# When set, new Telegram users outside the list are rejected.
TELEGRAM_ALLOWLIST=

# Email: resend | webhook | console | none
# In development the default is console (link is echoed in the API response).
# EMAIL_PROVIDER=none disables email login; /login hides the email form.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_APP_NAME=Chiron
# Compatible webhook for magic links. Receives {to, url}.
EMAIL_WEBHOOK_URL=

# LLM gateway. Without a key the deterministic parser and rule explanations are used.
# LLM_ENABLED=0 is the kill switch.
# LLM_PROVIDER: openai (OpenAI-compatible /chat/completions), gemini, or none.
LLM_ENABLED=1
LLM_PROVIDER=openai
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=~deepseek/deepseek-v4-flash-latest
LLM_JSON_MODE=1
# Legacy Gemini provider; used only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
LLM_DAILY_BUDGET_USD=0.02
LLM_MONTHLY_BUDGET_USD=5
LLM_GLOBAL_MONTHLY_BUDGET_USD=50
LLM_BUDGET_ALERT_RATIO=0.8
LLM_INPUT_USD_PER_1M=0.1
LLM_OUTPUT_USD_PER_1M=0.4
