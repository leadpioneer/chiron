# Staging environment for docker-compose.staging.yml.
# Copy to .env.staging and never commit the filled file.

POSTGRES_USER=chiron
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=chiron_staging

# Public HTTPS URL. Must match DOMAIN.
APP_URL=https://staging.example.com
DOMAIN=staging.example.com
ACME_EMAIL=admin@example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DEV_MODE=0
ALLOWED_ORIGINS=
# Exact emails or *@domain, comma-separated. May stay empty when
# TELEGRAM_ALLOWLIST is set; new email signups are then blocked.
ALPHA_EMAIL_ALLOWLIST=

# Telegram Mini App / Login Widget
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWLIST=

# Email: resend | webhook | none. Use none for Telegram-only alpha.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="Chiron <no-reply@example.com>"
EMAIL_REPLY_TO=
EMAIL_APP_NAME=Chiron
EMAIL_WEBHOOK_URL=

# LLM. LLM_ENABLED=0 is the kill switch.
LLM_ENABLED=1
LLM_PROVIDER=openai
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=~deepseek/deepseek-v4-flash-latest
LLM_JSON_MODE=1
GEMINI_API_KEY=
LLM_DAILY_BUDGET_USD=0.02
LLM_MONTHLY_BUDGET_USD=5
LLM_GLOBAL_MONTHLY_BUDGET_USD=50
LLM_BUDGET_ALERT_RATIO=0.8
LLM_INPUT_USD_PER_1M=0.1
LLM_OUTPUT_USD_PER_1M=0.4

BACKUP_RETENTION_DAYS=14
